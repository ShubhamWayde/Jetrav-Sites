# Copy this file to .env.local (for local dev) or .env.prod (for production).
# Select which file to load by setting GO_ENV before running:
#   GO_ENV=local  go run ./cmd/server/   ← default when GO_ENV is unset
#   GO_ENV=prod   go run ./cmd/server/

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

PORT=8080

JWT_SECRET=

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── App environment ───────────────────────────────────────────────────────────
# "development" → OTP logged to console + returned in API response (no SMS sent)
# "production"  → OTP sent via Twilio
APP_ENV=development

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
