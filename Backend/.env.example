# ── Redis ─────────────────────────────────────────────────────────────────────
# Use a full redis:// URL  OR just host:port  (password optional)
REDIS_URL=127.0.0.1:6379
REDIS_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

PORT=8080

JWT_SECRET=

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── App environment ───────────────────────────────────────────────────────────
# "development" → OTP logged to console + returned in API response (no SMS sent)
# "production"  → OTP sent via Twilio
APP_ENV=development
# APP_ENV=production

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get test keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx