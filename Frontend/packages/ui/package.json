{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./styles/css/*": "./styles/css/*",
    "./components/*": "./src/components/*.tsx",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build:icons": "svgr ./src/Icons/raw --out-dir ./src/Icons/generated --typescript --icon --replace-attr-values #F0F0F0=currentColor"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.0.1",
    "typescript": "5.9.3",
    "@svgr/cli": "^8.1.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
