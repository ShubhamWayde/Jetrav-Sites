{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./styles/css/*": "./styles/css/*",
    "./components/*": "./src/components/*.tsx",
    "./utilities": "./src/utils/utils.ts",
    "./fonts/fonts": "./src/fonts/fonts.tsx",
    "./icon": "./src/icon/index.ts",
    "./icon/*": "./src/icon/*.tsx",
    "./Table": "./src/components/Table/index.ts",
    "./Button": "./src/components/Button/index.ts",
    "./Spinner": "./src/components/spinner/index.ts",
    "./InputField": "./src/components/InputField/index.ts",
    "./TextareaField": "./src/components/TextareaField/index.ts",
    "./SelectField": "./src/components/SelectField/index.ts",
    "./Modal": "./src/components/Modal/index.ts",
    "./AppLayout": "./src/components/AppLayout/index.ts",
    "./AppSidebar": "./src/components/AppSidebar/index.ts",
    "./AppHeader": "./src/components/AppHeader/index.ts",
    "./Logo": "./src/components/logo/index.ts",
    "./FormError": "./src/components/FormError/index.ts",
    "./ToastMessage": "./src/components/ToastMessage/index.ts",
    "./*": [
      "./src/components/*/index.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build:icons": "svgr ./src/icon/raw --out-dir ./src/icon/generated --typescript --icon --replace-attr-values #F0F0F0=currentColor"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.0.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
